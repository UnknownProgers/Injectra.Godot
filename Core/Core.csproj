<Project Sdk="Godot.NET.Sdk/4.6.1">
	<PropertyGroup>
		<AssemblyName>Injectra.Godot</AssemblyName>
		<RootNamespace>Injectra.Godot</RootNamespace>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup Condition="'$(InjectraSourcePath)' == ''">
		<PackageReference Include="Injectra" Version="0.5.1-alpha.2"/>
	</ItemGroup>
	<ItemGroup Condition="'$(InjectraSourcePath)' != ''">
		<ProjectReference Include="$(InjectraSourcePath)/Core/Core.csproj"/>
	</ItemGroup>
	<ItemGroup>
	  <Content Include="addon\icons\icon.png" />
	  <Content Include="addon\icons\icon.png.import" />
	  <Content Include="addon\README.md" />
	</ItemGroup>
</Project>
